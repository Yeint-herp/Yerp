module dbg::print;

using WritableInto(T) = compiles(T x) {
    x.write("H");
    x.write(u"H");
    x.write('H');
};

public enum FormatArg {
    @implicit_construction Str([]const char),
    @implicit_construction CStr(const char*),
    @implicit_construction Int(i64),
    @implicit_construction Uint(u64),
}

void print(T)(T out, char c) if WritableInto(T) {
    out.write(c as char);
}

void print(T)(T out, []const char s) if WritableInto(T) {
    if s.len > 0 {
        out.write(s);
    }
}

public void newline(T)(T out) {
    out.print(13 as char);
    out.print(10 as char);
}

public void print(T)(T out, u64 n_val) if WritableInto(T) {
    char[20] buf;

    u64 n = n_val;
    if n == 0 {
        buf[0] = '0';
        out.write(buf[0]);
        return;
    }

    u64 pos = 0;
    while n > 0 {
        u64 d = n % 10;
        n = n / 10;
        buf[pos] = (('0' as u64) + d) as char;
        pos = pos + 1;
    }

    while pos > 0 {
        pos = pos - 1;
        out.write(buf[pos]);
    }
}

public void print(T)(T out, i64 n_val) {
    char[21] buf;
    u64 pos = 0;
    i64 n = n_val;

    bool negative = n < 0;
    if negative {
        n = -n;
    }

    if n == 0 {
        buf[0] = '0';
        out.write(buf[0]);
        return;
    }

    while n > 0 {
        u64 d = (n % 10) as u64;
        n = n / 10;
        buf[pos] = (('0' as u64) + d) as char;
        pos = pos + 1;
    }

    if negative {
        buf[pos] = '-';
        pos = pos + 1;
    }

    while pos > 0 {
        pos = pos - 1;
        out.write(buf[pos]);
    }
}

void print_hex(T)(T out, u64 n_val) if WritableInto(T) {
    char[16] buf;
    u64 n = n_val;

    if n == 0 {
        buf[0] = '0';
        out.write(buf[0]);
        return;
    }

    u64 pos = 0;
    while n > 0 {
        u64 d = n % 16;
        n = n / 16;
        if d < 10 {
            buf[pos] = (('0' as u64) + d) as char;
        } else {
            buf[pos] = (('a' as u64) + (d - 10)) as char;
        }
        pos = pos + 1;
    }

    while pos > 0 {
        pos = pos - 1;
        out.write(buf[pos]);
    }
}

void print(T)(T out, const char* cstr) if WritableInto(T) {
    u64 i = 0;
    while cstr[i] != 0 as char {
        out.write(cstr[i]);
        i = i + 1;
    }
}

void format_one(T)(T out, FormatArg arg, char spec_kind) if WritableInto(T) {
    match arg {
        FormatArg::Str(s) => {
            out.write(s);
        },
        FormatArg::CStr(cstr) => {
            out.print(cstr);
        },
        FormatArg::Int(val) => {
            i64 n = val;
            if spec_kind == ('u') {
                if n < 0 {
                    out.write('-');
                    n = -n;
                }

                out.print(n as u64);
            } else if spec_kind == ('x') {
                if n < 0 {
                    out.write('-');
                    n = -n;
                }

                out.print_hex(n as u64);
            } else {
                out.print(n);
            }
        },
        FormatArg::Uint(val) => {
            u64 n = val;
            if spec_kind == ('d') {
                out.print(n as i64);
            } else if spec_kind == ('x') {
                out.print_hex(n);
            } else {
                out.print(n);
            }
        },
    }
}

char read_spec([]const char fmt, u64 spec_start, u64 spec_len) {
    if spec_len == 0 {
        return 0 as char;
    }

    char sc = fmt[spec_start];
    if sc == ('d') {
        return 'd';
    }

    if sc == ('u') {
        return 'u';
    }

    if sc == ('x') {
        return 'x';
    }

    return 0 as char;
}

void emit_arg(T)(T out, []const FormatArg args, u64 arg_idx, char kind) if WritableInto(T) {
    if arg_idx < args.len {
        out.format_one(args[arg_idx], kind);
    } else {
        out.write("<missing>");
    }
}

void format_impl(T)(T out, []const char fmt, []const FormatArg args) if WritableInto(T) {
    u64 arg_idx = 0;
    u64 i = 0;

    while i < fmt.len {
        char c = fmt[i];

        if c == ('{') {
            if i + 1 < fmt.len {
                if fmt[i + 1] == ('{') {
                    out.print(c);
                    i = i + 2;
                    continue;
                }
            }

            u64 spec_start = i + 1;
            i = i + 1;
            while i < fmt.len {
                if fmt[i] == ('}') {
                    break;
                }

                i = i + 1;
            }

            if i >= fmt.len {
                out.print('{');
                u64 j = spec_start;
                while j < fmt.len {
                    out.print(fmt[j]);
                    j = j + 1;
                }

                return;
            }

            u64 spec_len = i - spec_start;
            char kind = read_spec(fmt, spec_start, spec_len);

            i = i + 1;

            out.emit_arg(args, arg_idx, kind);
            arg_idx = arg_idx + 1;
        } else if c == ('}') {
            if i + 1 < fmt.len {
                if fmt[i + 1] == ('}') {
                    out.print(c);
                    i = i + 2;
                    continue;
                }
            }

            out.print(c);
            i = i + 1;
        } else {
            out.print(c);
            i = i + 1;
        }
    }
}

public void print(T)(T out, []const char msg) if WritableInto(T) {
    FormatArg[0] empty;
    out.format_impl(msg, empty);
}

public void println(T)(T out, []const char msg) if WritableInto(T) {
    FormatArg[0] empty;
    out.format_impl(msg, empty);
    out.newline();
}

public void print(T)(T out, []const char fmt, []const FormatArg args) if WritableInto(T) {
    out.format_impl(fmt, args);
}

public void println(T)(T out, []const char fmt, []const FormatArg args) if WritableInto(T) {
    out.format_impl(fmt, args);
    out.newline();
}
