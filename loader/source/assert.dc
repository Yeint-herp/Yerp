module assert;

import entry;
import efi;
import dbg::print;

void write_assert_to(
    efi::protocols::console::simple_text_output* out,
    []const char file,
    i32 line,
    []const char function,
    []const char expr
) {
    out.write(file);
    out.write(":");
    out.print(line as u64);
    out.write(" ");
    out.write(function);
    out.write(": Assertion `");
    out.write(expr);
    out.write("` failed.\r\n");
}

void __assert([]const char file, i32 line, []const char function, []const char expr) {
    write_assert_to(entry::st.console_out, file, line, function, expr);
    write_assert_to(entry::st.console_err, file, line, function, expr);

    for ;; {}
}
