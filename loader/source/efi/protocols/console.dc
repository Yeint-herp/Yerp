module efi::protocols::console;

public import efi;
public import efi::boot_services;
public import efi::status;

public const guid simple_text_input_protocol = {0x387477c1, 0x69c7, 0x11d2, {0x8e, 0x39, 0x00, 0xa0, 0xc9, 0x69, 0x72, 0x3b}};
public const guid simple_text_output_protocol = {0x387477c2, 0x69c7, 0x11d2, {0x8e, 0x39, 0x00, 0xa0, 0xc9, 0x69, 0x72, 0x3b}};

public enum scancodes {
    Null = 0x0,
    ArrowUp = 0x1,
    ArrowDown = 0x2,
    ArrowRight = 0x3,
    ArrowLeft = 0x4,
    Home = 0x5,
    End = 0x6,
    Insert = 0x7,
    Delete = 0x8,
    PageUp = 0x9,
    PageDown = 0xa,
    Fn1 = 0xb,
    Fn2 = 0xc,
    Fn3 = 0xd,
    Fn4 = 0xe,
    Fn5 = 0xf,
    Fn6 = 0x10,
    Fn7 = 0x11,
    Fn8 = 0x12,
    Fn9 = 0x13,
    Fn10 = 0x14,
    Fn11 = 0x15,
    Fn12 = 0x16,
    Esc = 0x17
}

public using input_read_key = u64(*)(simple_text_input*, input_key*);
public using input_reset = u64(*)(simple_text_input*, bool);

public struct input_key {
    u16 scan_code;
    u16 unicode;
}

public struct simple_text_input {
    input_reset reset;
    input_read_key read_keystroke;
    event wait_for_key;
}

public using output_string = u64(*)(simple_text_output*, const u16*);
public using output_test_string = u64(*)(simple_text_output*, const u16*);
public using output_query_mode = u64(*)(simple_text_output*, u64, u64*, u64*);
public using output_set_mode = u64(*)(simple_text_output*, u64);
public using output_set_attribute = u64(*)(simple_text_output*, u64);
public using output_clear_screen = u64(*)(simple_text_output*);
public using output_set_cursor_position = u64(*)(simple_text_output*, u64, u64);
public using output_enable_cursor = u64(*)(simple_text_output*, bool);
public using output_reset = u64(*)(simple_text_output*, bool);

public struct simple_text_output {
    output_reset reset;
    output_string output_string;
    output_test_string test_string;
    output_query_mode query_mode;
    output_set_mode set_mode;
    output_set_attribute set_attribute;
    output_clear_screen clear_screen;
    output_set_cursor_position set_cursor_position;
    output_enable_cursor enable_cursor;

    simple_text_output_mode* mode;
}

public struct simple_text_output_mode {
    i32 max_mode;
    i32 mode;

    i32 attributes;

    i32 cursor_column;
    i32 cursor_row;
    bool cursor_visible;
}

public status::status write(simple_text_output* self, []const u16 str) {
    return self.output_string(self, str.ptr) as status::status;
}

public status::status write(simple_text_output* self, []const char str) {
    const u64 max_len = str.len * 2;
    u16[max_len + 1] buf;

    u64 i = 0;
    u64 limit = if str.len < max_len { str.len } else { max_len };
    while (i < limit) {
        buf[i] = str[i] as u16;
        i++;
    }

    buf[i] = 0;
    return self.output_string(self, buf as const u16*) as status::status;
}

public status::status write(simple_text_output* self, const char ch) {
    []const char str = {ch};
    return self.write(str) as status::status;
}

public status::status write(simple_text_output* self, const u16 ch) {
    []const u16 str = {ch};
    return self.write(str) as status::status;
}

public status::status clear(simple_text_output* self) {
    return self.clear_screen(self) as status::status;
}

public status::status set_cursor(simple_text_output* self, u64 col, u64 row) {
    return self.set_cursor_position(self, col, row) as status::status;
}

public status::status enable_cursor(simple_text_output* self, bool visible) {
    return self.enable_cursor(self, visible) as status::status;
}

public status::status set_attribute(simple_text_output* self, u64 attr) {
    return self.set_attribute(self, attr) as status::status;
}

public status::status read_key(simple_text_input* self, boot_services::boot_services_table* bs, input_key* key) {
    u64 index;
    void*[1] events = { self.wait_for_key };

    status::status st = boot_services::wait_for_event(bs, 1, events as void**, &index);
    if st != status::status::Success {
        return st;
    }

    return self.read_keystroke(self, key) as status::status;
}

public status::status poll_key(simple_text_input* self, input_key* key) {
    return self.read_keystroke(self, key) as status::status;
}
